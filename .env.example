# CardioSentry settings — copy to .env and edit. The PostgreSQL URL is required;
# other settings are optional. Defaults below match the training pipeline
# (do not change preprocess values unless the experiment needs them).

# --- serving ---------------------------------------------------------------
# CARDIOSENTRY_HOST=0.0.0.0        # LAN serving (phones reach the laptop)
# CARDIOSENTRY_PORT=8000
# CARDIOSENTRY_LOCAL_ONLY=false    # true = bind 127.0.0.1 only (shared networks)
# CARDIOSENTRY_APP_TOKEN=          # optional shared-secret gate (§19.2)

# --- database (PostgreSQL, local only) ---------------------------------------
# CARDIOSENTRY_DATABASE_URL=postgresql://cardiosentry:<password>@127.0.0.1:5432/cardiosentry
# DATABASE_URL is also accepted; CARDIOSENTRY_DATABASE_URL wins if both are set.
# Host must be localhost, 127.0.0.1, ::1 or a local Unix-socket path.
# Tests recreate <db>_test, never the configured database.

# --- data privacy (RA 10173, Philippines) -----------------------------------
# Shown in the in-app Data Privacy Notice. Set both before photographing
# anyone else's ECG; unset, the notice says it is not configured.
# CARDIOSENTRY_PRIVACY_CONTROLLER="<your name>, CardioSentry thesis, <university>"
# CARDIOSENTRY_PRIVACY_CONTACT=privacy@example.com

# --- paths -----------------------------------------------------------------
# CARDIOSENTRY_DATA_DIR=           # default: <app>/captures
# CARDIOSENTRY_MODELS_DIR=         # default: <app>/models
# CARDIOSENTRY_ACTIVE_MODEL=       # default: models/active.yaml symlink

# --- model -----------------------------------------------------------------
# CARDIOSENTRY_DEVICE=cpu
# CARDIOSENTRY_NUM_THREADS=4       # pinned + recorded: keeps forward_ms comparable

# --- startup self-check (§10.6) ----------------------------------------------
# The active descriptor's `verify` block wins over both of the settings below
# (models/*.yaml: verify.expected_scores, verify.score_tolerance) — the
# reference vector and the tolerance are properties of the checkpoint. These
# are the fallback for a descriptor that pins neither.
# CARDIOSENTRY_VERIFY_FIXTURE_IMAGE=tests/fixtures/corpus_sheet.jpg
# CARDIOSENTRY_VERIFY_EXPECTED_SCORES_JSON=tests/fixtures/expected_scores.json
# CARDIOSENTRY_VERIFY_SCORE_TOLERANCE=2e-3

# --- ingest (§16, §13.4) ----------------------------------------------------
# CARDIOSENTRY_MAX_UPLOAD_BYTES=31457280
# CARDIOSENTRY_MAX_IMAGE_PIXELS=200000000
# CARDIOSENTRY_STRIP_GPS=true

# --- detection (§8) ----------------------------------------------------------
# CARDIOSENTRY_DETECT_DOWNSCALE_TO=1024
# CARDIOSENTRY_DETECT_MIN_AREA_FRAC=0.15
# CARDIOSENTRY_DETECT_EXPECTED_ASPECT=1.294   # null disables the weak prior
# CARDIOSENTRY_DETECT_CONFIDENCE_WARN=0.55
# CARDIOSENTRY_PAPER_WIDTH_MM=279.4           # US Letter landscape

# --- rectification (§8.5) -----------------------------------------------------
# CARDIOSENTRY_GEOMETRY_MODE=training_canvas  # training_canvas | native_aspect
# CARDIOSENTRY_CANVAS_PX="[1650,1275]"
# CARDIOSENTRY_MARGIN_PX=18

# --- explainability -----------------------------------------------------------
# Grad-CAM only: one forward plus a partial backward per label on CPU (seconds).
# CARDIOSENTRY_EXPLAIN_ENABLED=true
# CARDIOSENTRY_EXPLAIN_OVERLAY_ALPHA=0.5
# CARDIOSENTRY_EXPLAIN_COLORMAP=turbo
# CARDIOSENTRY_EXPLAIN_PERCENTILE_CLIP=99.0
# CARDIOSENTRY_EXPLAIN_SAVE_RAW=false      # also write raw.npz (float16 maps)
# CARDIOSENTRY_EXPLAIN_MAX_RUNS_PER_CAPTURE=50

# --- quality (§14 — warn, never block) ----------------------------------------
# CARDIOSENTRY_QUALITY_BLOCK_ON_POOR=false
# CARDIOSENTRY_WARN_BLUR_VARLAP=100.0
# CARDIOSENTRY_WARN_BRIGHTNESS_LO=0.25
# CARDIOSENTRY_WARN_BRIGHTNESS_HI=0.85
# CARDIOSENTRY_WARN_CONTRAST_P5P95=0.30
# CARDIOSENTRY_WARN_CLIPPED_HIGH_FRAC=0.05
# CARDIOSENTRY_WARN_CLIPPED_LOW_FRAC=0.05
# CARDIOSENTRY_WARN_GLARE_BLOB_FRAC=0.01
# CARDIOSENTRY_WARN_PX_PER_MM=6.0
# CARDIOSENTRY_WARN_SKEW_DEG=25.0
# CARDIOSENTRY_WARN_AREA_FRACTION=0.35
